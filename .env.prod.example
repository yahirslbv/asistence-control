# Configuración de la pila de producción (docker-compose.prod.yml).
#
# Copia este archivo como .env.prod y cambia TODOS los valores CAMBIA-ESTO.
# .env.prod no se versiona: compruébalo con `git check-ignore -v .env.prod`.
# Con una clave o una contraseña sin cambiar, la pila se niega a arrancar.
#
# En las claves y contraseñas usa solo letras, números, guiones y guiones
# bajos (sin espacios, comillas, # ni $). Para generar una:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Sitio ---------------------------------------------------------------
# Dirección que atiende el proxy (Caddy):
#   http://localhost   demostración local por HTTP
#   :80                HTTP para cualquier nombre o IP (demostración en la red local)
#   midominio.com      dominio real: Caddy obtiene el certificado y sirve HTTPS
DOMINIO=http://localhost

# Nombres con los que se entra al sitio, separados por comas y sin http://.
DJANGO_ALLOWED_HOSTS=localhost

# 1 solo cuando el sitio se sirve por HTTPS (dominio real). Con 1 las cookies
# se marcan «solo HTTPS» y por HTTP nadie podría iniciar sesión.
DJANGO_HTTPS=0

# Orígenes de confianza para los formularios, con esquema y separados por
# comas (https://midominio.com). Normalmente se queda vacía.
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Django --------------------------------------------------------------
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=CAMBIA-ESTO

# --- Base de datos -------------------------------------------------------
# OJO: estos cuatro valores solo se aplican la PRIMERA vez que arranca el
# volumen de MySQL. Cambiarlos después aquí no cambia nada en la base: usa
# ALTER USER dentro de MySQL y luego actualiza este archivo (ver README).
MYSQL_ROOT_PASSWORD=CAMBIA-ESTO
DB_NAME=control_asistencia
DB_USER=asistencia
DB_PASSWORD=CAMBIA-ESTO

# --- Aplicación ----------------------------------------------------------
# Porcentaje mínimo de asistencia.
ASISTENCIA_MINIMA=80
# Dominios de correo que pueden registrarse solos, separados por comas.
# Vacía, cierra el registro.
REGISTRO_DOMINIOS=uabc.edu.mx
